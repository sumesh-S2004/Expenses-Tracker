PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/wealthflow
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
# Production: https://expenses-tracker-delta-five.vercel.app
NODE_ENV=development

# Google sign-in ("Continue with Google"). Create an OAuth Web client at console.cloud.google.com
# (APIs & Services > Credentials) and add http://localhost:5173 under Authorized JavaScript origins.
# Use the SAME client id in frontend/.env as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# Optional - email for "Forgot password".
# If SMTP_HOST is empty, the reset link is printed in this server's console
# (and returned in the API response while NODE_ENV is not "production").
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=WealthFlow <no-reply@wealthflow.local>
